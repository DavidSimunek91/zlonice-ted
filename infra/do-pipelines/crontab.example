# Crontab pro spouštění datových pipeline přímo na droplu — viz README.md
# v tomhle adresáři pro vysvětlení proč a jak to nainstalovat.
#
# Uprav <CESTA_K_REPU> a <CESTA_K_ENV_SOUBORU> podle skutečných cest na
# serveru (README.md ukazuje doporučené umístění), pak:
#   crontab crontab.example
# (nebo si obsah zkopíruj do `crontab -e`, ať máš pod kontrolou, jestli
# tam už něco jiného nemáš)
#
# Skutečný cron nemá problém s "kulatými" minutami jako GitHub Actions
# schedule trigger (to je problém specifický pro GitHubův sdílený
# scheduler, ne pro obyčejný cron na vlastním stroji) — proto tu jsou
# obyčejné, čitelné intervaly.

# Voda (ČHMÚ, Velvary) — každých 15 minut
*/15 * * * * . <CESTA_K_ENV_SOUBORU> && <CESTA_K_REPU>/infra/do-pipelines/run-and-push.sh scripts/update-water.mjs data/water.json "Update water data" >> $HOME/zlonice-ted-cron.log 2>&1

# ČHMÚ výstrahy — každých 10 minut
*/10 * * * * . <CESTA_K_ENV_SOUBORU> && <CESTA_K_REPU>/infra/do-pipelines/run-and-push.sh scripts/update-alerts.mjs data/alerts.json "Update ČHMÚ alerts" >> $HOME/zlonice-ted-cron.log 2>&1

# Doprava (ŘSD/NDIC) — každých 15 minut. Droplet je u ŘSD potvrzeně
# blokovaný — vyžaduje RSD_PROXY_URL/PROXY_KEY v env souboru (domácí proxy
# na MSI notebooku, viz home-proxy/README.md). Bez nich skript zkusí volat
# ŘSD přímo a skončí na timeoutu do status:"error" (viz komentář ve
# scripts/update-traffic.mjs).
*/15 * * * * . <CESTA_K_ENV_SOUBORU> && <CESTA_K_REPU>/infra/do-pipelines/run-and-push.sh scripts/update-traffic.mjs data/traffic.json "Update traffic data" >> $HOME/zlonice-ted-cron.log 2>&1

# Zimní sjízdnost silnic (ŘSD/NDIC) — každých 30 minut, samostatný odběr
# od dopravy výš, vlastní RSD_WINTER_USERNAME/RSD_WINTER_PASSWORD v env
# souboru (stejný RSD_PROXY_URL/PROXY_KEY jako doprava). Bez
# RSD_WINTER_USERNAME/RSD_WINTER_PASSWORD skript jen zapíše pending_access
# a nic nevolá (viz scripts/update-winter-roads.mjs). Mimo zimní sezónu
# ŘSD podle registru data vůbec neposkytuje, to není chyba pipeline.
*/30 * * * * . <CESTA_K_ENV_SOUBORU> && <CESTA_K_REPU>/infra/do-pipelines/run-and-push.sh scripts/update-winter-roads.mjs data/winter-roads.json "Update winter roads data" >> $HOME/zlonice-ted-cron.log 2>&1

# Autobusy — jízdní řád jednou denně v 6:00 UTC
0 6 * * * . <CESTA_K_ENV_SOUBORU> && <CESTA_K_REPU>/infra/do-pipelines/run-and-push.sh scripts/update-departures.mjs data/departures.json "Update bus departures" >> $HOME/zlonice-ted-cron.log 2>&1

# Autobusy — živé zpoždění každých 5 minut (jen když je GOLEMIO_API_KEY
# nastavený v env souboru; jinak skript sám nic nedělá)
*/5 * * * * . <CESTA_K_ENV_SOUBORU> && <CESTA_K_REPU>/infra/do-pipelines/run-and-push.sh scripts/update-live-departures.mjs data/live-departures.json "Update live bus delays" >> $HOME/zlonice-ted-cron.log 2>&1

# Návštěvnost webu — každých 15 minut. Nepotřebuje žádné tajné hodnoty v
# env souboru (VISIT_LOG_PATH má rozumný default), ale vyžaduje běžící
# infra/visit-log/beacon-server.mjs — viz infra/visit-log/README.md.
*/15 * * * * . <CESTA_K_ENV_SOUBORU> && <CESTA_K_REPU>/infra/do-pipelines/run-and-push.sh scripts/aggregate-visits.mjs data/stats.json "Update visit stats" >> $HOME/zlonice-ted-cron.log 2>&1

# Úřední deska (RSS ze zlonice.cz) — jednou denně, deska se mění málokdy.
# Nepotřebuje žádné tajné hodnoty v env souboru, ale vyžaduje na droplu
# nainstalované poppler-utils a tesseract-ocr(-ces) — jednorázově:
#   sudo apt-get install -y poppler-utils tesseract-ocr tesseract-ocr-ces
# (viz komentář v scripts/update-uredni-deska.mjs)
7 6 * * * . <CESTA_K_ENV_SOUBORU> && <CESTA_K_REPU>/infra/do-pipelines/run-and-push.sh scripts/update-uredni-deska.mjs data/uredni-deska.json "Update úřední deska" >> $HOME/zlonice-ted-cron.log 2>&1
