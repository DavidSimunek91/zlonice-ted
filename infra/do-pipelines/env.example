# Šablona souboru s tajnými hodnotami pro pipeline na droplu.
# Zkopíruj mimo git (viz README.md — NIKDY tenhle soubor s reálnými
# hodnotami necommituj) a vyplň skutečné hodnoty, např. do:
#   /home/<uzivatel>/zlonice-ted.env
#
# Stejné hodnoty jako GitHub Actions repo secrets (Settings → Secrets and
# variables → Actions) — jen je tu potřeba mít i fyzicky na disku droplu,
# protože cron tu nemá GitHubí "secrets" mechanismus k dispozici.

# ŘSD/NDIC (doprava) — přihlašovací údaje k odběru "DATEX II - Běžné
# dopravní informace v2 (snímek)" z mobilitydata.rsd.cz
export RSD_USERNAME="DOPLNIT"
export RSD_PASSWORD="DOPLNIT"

# Droplet je u ŘSD potvrzeně blokovaný (zkoušeno, nejde jen o teoretické
# riziko z kroku 1 v README.md) — produkční cesta je přes domácí proxy na
# MSI notebooku, viz home-proxy/README.md. Bez tohohle obě ŘSD pipeline
# (doprava i zimní sjízdnost níž) skončí v status:"error" na timeoutu.
export RSD_PROXY_URL="http://<tailscale-ip-notebooku>:8787/"
export PROXY_KEY="DOPLNIT"

# ŘSD/NDIC (zimní sjízdnost) — SAMOSTATNÝ odběr "DDR - Zimní sjízdnost
# (snímek)" z mobilitydata.rsd.cz, navíc k odběru pro dopravu výš. Portál
# ke KAŽDÉMU odběru generuje vlastní přihlašovací údaje (ne stejné jako u
# dopravy výš) — zkopíruj je sem přesně, jak je portál ukázal po schválení
# tohohle odběru. Cílová URL je už natvrdo v scripts/update-winter-
# roads.mjs (ověřeno na portálu), žádná další proměnná pro ni není
# potřeba — jen běží přes STEJNÝ proxy a token výš (RSD_PROXY_URL/
# PROXY_KEY), žádná nová hodnota na notebooku.
export RSD_WINTER_USERNAME="DOPLNIT"
export RSD_WINTER_PASSWORD="DOPLNIT"

# Golemio (živé zpoždění autobusů) — nepovinné, bez něj
# update-live-departures.mjs jen nic neudělá (appka pak ukazuje "žádná
# data o zpoždění")
export GOLEMIO_API_KEY="DOPLNIT"
