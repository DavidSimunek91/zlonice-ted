# Zkopíruj do .env vedle server.mjs (NIKDY necommituj soubor .env samotný).
# Na rozdíl od droplet/env.example se tenhle soubor nesourcuje v shellu —
# čte ho přímo server.mjs, proto BEZ "export" na začátku řádku.

# Sdílený token mezi tímhle proxy a droplem — musí sedět se stejnojmennou
# hodnotou PROXY_KEY v ~/zlonice-ted.env na droplu. Vygeneruj v PowerShellu:
#   -join ((48..57)+(97..102)|Get-Random -Count 48|%{[char]$_})
PROXY_KEY=DOPLNIT

# Port — shoduje se s tím, na co ukazuje RSD_PROXY_URL na droplu.
PORT=8787

# Tailscale IP tohohle notebooku (zjisti přes `tailscale ip -4` AŽ PO
# instalaci Tailscale — viz README.md krok 3). Dokud tu zůstane prázdné/
# komentované, proxy poslouchá jen na 127.0.0.1 a droplet se k ní vůbec
# nedostane — bezpečný výchozí stav.
# BIND_HOST=100.x.y.z
